{
  "paths": {
    "triposr_python": "auto",
    "triposr_dir": "../TripoSR-main",
    "blender_exe": "auto",
    "work_root": "../data/work",
    "output_root": "~/Desktop",
    "mast3r_python": "auto",
    "mast3r_dir": "auto",
    "multiview_script": "mast3r_multiview_runner.py",
    "meshlabserver_exe": "auto",
    "instant_meshes_exe": "auto",
    "history_file": "../data/3d_agent_history.jsonl",
    "last_error_file": "../data/3d_agent_last_error.txt",
    "task_db": "../data/agent_tasks.sqlite3",
    "current_model_file": "../data/current_model.json"
  },
  "runtime": {
    "default_backend": "TripoSR",
    "device": "cuda",
    "craftsman_mode": "remote_only",
    "allow_backend_fallback": true,
    "terminate_grace_seconds": 5
  },
  "external_multiview": {
    "enabled": false,
    "experimental": true
  },
  "llm_blender_agent": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 9876,
    "connect_timeout_seconds": 2,
    "command_timeout_seconds": 120,
    "prefer_live_modification": false,
    "fallback_to_background": true,
    "addon_source": "../LLM-Blender-Agent-main/LLM-Blender-Agent-main/addon.py"
  },
  "craftsman_api": {
    "enabled": true,
    "generate_url": "https://www.sanrenxietong.com/craftsman-api/generate",
    "health_url": "https://www.sanrenxietong.com/craftsman-api/health",
    "api_key_env": "CRAFTSMAN_API_KEY",
    "steps": 50,
    "seed": 0,
    "guidance_scale": 5.0,
    "octree_depth": 7,
    "remove_background": true,
    "foreground_ratio": 1.0,
    "require_multiview_confirmation": false
  },
  "vision_api": {
    "enabled": true,
    "api_key_env": "JIAORONG_API_KEY",
    "base_url_env": "OPENAI_API_BASE",
    "model_env": "OPENAI_VISION_MODEL",
    "fallback_model_env": "AIDER_MODEL"
  },
  "conversation_api": {
    "enabled": true,
    "api_key_env": "JIAORONG_API_KEY",
    "base_url_env": "OPENAI_API_BASE",
    "model_env": "OPENAI_CHAT_MODEL",
    "fallback_model_env": "AIDER_MODEL",
    "max_history_messages": 16
  },
  "quality": {
    "render_resolution": 512,
    "visual_similarity_warning_threshold": 60.0,
    "missing_silhouette_warning_ratio": 0.08,
    "color_difference_warning_percent": 25.0,
    "enable_semantic_visual_comparison": true,
    "max_visual_repair_attempts": 3
  },
  "timeouts_seconds": {
    "default_process": 900,
    "triposr": 900,
    "multiview": 1800,
    "blender": 600,
    "model_check": 180,
    "refinement": 300,
    "health_probe": 30,
    "craftsman_api": 300,
    "visual_render": 300
  }
}
